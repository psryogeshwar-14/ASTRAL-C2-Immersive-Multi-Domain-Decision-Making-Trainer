# Astral-C2 Tactical Training Environment Configuration

# Backend Server Port
PORT=3001

# Optional: Google Gemini API Key for online After Action Review (AAR) summary generation.
# If omitted, Astral-C2 automatically runs its offline, deterministic DSSC Military Evaluator.
GEMINI_API_KEY=

# Client Connection URLs (defaults to window.location.hostname in browser)
VITE_SERVER_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
